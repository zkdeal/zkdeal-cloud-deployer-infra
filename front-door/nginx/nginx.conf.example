worker_processes auto;
pid /tmp/nginx.pid;

events { worker_connections 4096; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  limit_req_zone $binary_remote_addr zone=rpc:10m rate=20r/s;

  # Replace these ranges with the exact networks owned by the load balancer.
  set_real_ip_from 10.0.0.0/8;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  upstream coordinator { server coordinator:3000; keepalive 32; }
  upstream operator_docs { server docs:8080; keepalive 8; }

  server {
    listen 8443 ssl http2;
    ssl_certificate /run/secrets/tls.crt;
    ssl_certificate_key /run/secrets/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    location ~ ^/(metrics|admission|indexer|queue)(/|$) { return 404; }
    location = /docs { return 308 /docs/; }
    location /docs/ {
      proxy_pass http://operator_docs/;
      proxy_set_header Host $host;
    }
    location / {
      limit_req zone=rpc burst=40 nodelay;
      proxy_pass http://coordinator;
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_id;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
  }
}

