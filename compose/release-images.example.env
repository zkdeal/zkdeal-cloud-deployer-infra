# Candidate image/promotion fragment only; this is not a complete runtime.env.
# Merge it with reviewed chain/endpoints and signer configuration-directory
# paths in an operator-owned candidate file. Never add credential contents.
# Owner-built images intentionally have no default. Resolve them from a build
# and record both the local image ID and pushed repository digest in evidence.
COORDINATOR_IMAGE_DIGEST=registry.example/zkdeal-coordinator@sha256:REPLACE
HEADLESS_NODE_IMAGE_DIGEST=registry.example/zkdeal-headless-room-node@sha256:REPLACE
AGENT_IMAGE_DIGEST=registry.example/zkdeal-prover-agent@sha256:REPLACE
PROVER_IMAGE_DIGEST=registry.example/zkdeal-risc0-cuda-runtime@sha256:REPLACE
DOCS_IMAGE_DIGEST=registry.example/zkdeal-operator-docs@sha256:REPLACE
PROMOTION_CONTROLLER_IMAGE_DIGEST=registry.example/zkdeal-promotion-controller@sha256:REPLACE
FAILOVER_PROVIDER_IMAGE_DIGEST=registry.example/zkdeal-failover-provider@sha256:REPLACE

# Automated promotion configuration contains references only. Keep the three
# token contents in distinct operator-owned files outside the source bundle.
# The example remains deliberately unarmed until a reviewed incident candidate
# and a real failover-provider implementation are ready.
ACTIVE_PROMOTION_HEALTH_URLS=https://active-witness-a.example/health,https://active-witness-b.example/health
FAILOVER_PROVIDER_URL=https://failover-provider-docker:8443/v1/failovers
FAILOVER_PROVIDER_ACTIVE_HEALTH_URLS=https://active-witness-a.example/health,https://active-witness-b.example/health
FAILOVER_PROVIDER_INDEXER_FRESHNESS_URL=https://canonical-indexer.example/hosting/v1/finality-status
PROMOTION_CANDIDATE_ID=replace-with-unique-lowercase-candidate
PROMOTION_CONTROLLER_ARMED=false
PROMOTION_FAILURE_THRESHOLD=3
PROMOTION_POLL_SECONDS=10
PROMOTION_MAX_RTO_SECONDS=240
PROMOTION_MAX_CHECKPOINT_AGE_SECONDS=30
PROMOTION_REQUEST_TIMEOUT_SECONDS=10
FAILOVER_PROVIDER_TOKEN_FILE=/run/operator/failover-provider.token
FAILOVER_APPROVAL_TOKEN_FILE=/run/operator/failover-approval.token
PROMOTION_PRINCIPAL_TOKEN_FILE=/run/operator/promotion-principal.token
FAILOVER_PROVIDER_TLS_CERT_FILE=/run/operator/failover-provider.crt
FAILOVER_PROVIDER_TLS_KEY_FILE=/run/operator/failover-provider.key
POSTGRES_REPLICATION_PASSWORD_FILE=/run/operator/postgres-replication-password
POSTGRES_PASSWORD_FILE=/run/operator/postgres-password
DOCKER_SOCKET_GID=0
POSTGRES_IMAGE_DIGEST=postgres@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
MINIO_IMAGE_DIGEST=minio/minio@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
MINIO_CLIENT_IMAGE_DIGEST=minio/mc@sha256:aead63c77f9db9107f1696fb08ecb0faeda23729cde94b0f663edf4fe09728e3
WEB3SIGNER_IMAGE_DIGEST=consensys/web3signer@sha256:48d05fa329615527b1c4f94b0a63b376540b143cd0d93fa3f56f584d81ddc9ce
CURL_IMAGE_DIGEST=curlimages/curl@sha256:4026b29997dc7c823b51c164b71e2b51e0fd95cce4601f78202c513d97da2922

