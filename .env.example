# Local-only defaults. Copy to .env; never use these credentials publicly.
ZKDEAL_PROFILE=local
ZKDEAL_STATE_DIR=../.state/local
ZKDEAL_BACKUP_DIR=../.state/local/backups

COORDINATOR_IMAGE=zkdeal-coordinator:local
HEADLESS_NODE_IMAGE=zkdeal-headless-room-node:local
QUEUE_IMAGE=zkdeal-coordinator:local
AGENT_IMAGE=zkdeal-prover-agent:local
AGENT_SOURCE_SHA256=7b026e5d1bc0eadbd4a0d9872cd7fa3871132396076a1b01b50576023cd9bc20
AGENT_CAPABILITY_SHA256=fda03b21a6a7bd9500c9d1a505a16afbfd705d23e4bb942096623fb43bcf5266
AGENT_TRACE_CAPABILITY_SHA256=6aa3092f6e3cc07ca58eb69ace2246916f6738b73a34b70839e16d9221529899
PROVER_IMAGE=zkdeal-risc0-cuda-runtime:local
DOCS_IMAGE=zkdeal-operator-docs:local
PROMOTION_CONTROLLER_IMAGE=zkdeal-promotion-controller:local
FAILOVER_PROVIDER_IMAGE=zkdeal-failover-provider:local
CADDY_IMAGE=caddy:2.10-alpine
NGINX_IMAGE=nginx:1.27-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.0
POSTGRES_IMAGE=postgres:17.6-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_CLIENT_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
OPENBAO_IMAGE=openbao/openbao:2.6.1
WEB3SIGNER_IMAGE=consensys/web3signer:26.4.2-distroless
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
LOKI_IMAGE=grafana/loki:3.5.3
PROMTAIL_IMAGE=grafana/promtail:3.5.3
CURL_IMAGE=curlimages/curl:8.15.0
TRUSTED_PROXY_CIDRS=192.0.2.10/32

CHAIN_ID=31337
L1_RPC_URL=http://host.docker.internal:8545
L1_RPC_URLS=http://host.docker.internal:8545,http://host.docker.internal:9545
L1_RPC_PROVIDER_IDS=local-rpc-a,local-rpc-b
BEACON_SIDECAR_URLS=http://host.docker.internal:5052,http://host.docker.internal:6052
ROOM_MANAGER=0x0000000000000000000000000000000000000000
ROOM_POOL=0x0000000000000000000000000000000000000000
ACCESS_TOKEN=0x0000000000000000000000000000000000000000

# Well-known local credentials. Production profiles reject them.
ZKDEAL_QUEUE_SUBMIT_TOKEN=local-queue-submitter-token-32chars
ZKDEAL_QUEUE_NODE_TOKEN=local-queue-node-token-32characters
ZKDEAL_PROVER_TOKEN=local-prover-token-32-characters
NODE_LIVENESS_SIGNER_URL=http://web3signer-liveness:9000
NODE_LIVENESS_ACCOUNT=0x1111111111111111111111111111111111111111
NODE_LIVENESS_SIGNER_AUTH_TOKEN=local-liveness-signer-token-at-least-32
NODE_LIVENESS_COORDINATOR_URL=http://coordinator:3000
NODE_LIVENESS_COORDINATOR_AUTH_TOKEN=local-l1-liveness-service-principal-token
NODE_ID=local-gpu-node-0

PUBLIC_HTTP_PORT=8088
LOCAL_QUEUE_PORT=3005
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-admin-only
POSTGRES_DB=zkdeal
POSTGRES_USER=zkdeal
POSTGRES_PASSWORD=local-postgres-password-only
MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=local-minio-password-only
OPENBAO_DEV_ROOT_TOKEN=local-openbao-root-token-only
WEB3SIGNER_CONFIG_DIR=../.state/local/web3signer
API_KEY_PEPPER=local-api-key-pepper-at-least-32-characters
DATABASE_URL=postgresql://zkdeal:local-postgres-password-only@postgres:5432/zkdeal
ACTIVE_COORDINATOR_ID=compose-active-region
STANDBY_COORDINATOR_ID=compose-standby-region
HOSTING_ADMIN_TOKEN=local-hosting-admin-token-at-least-32-chars
INDEXER_TOKEN=local-indexer-token-at-least-32-characters
ADMISSION_TOKEN=local-admission-token-at-least-32-chars
L1_SIGNER_URL=http://web3signer:9000
L1_SIGNER_ADDRESS=0x4444444444444444444444444444444444444444
L1_SIGNER_AUTH_TOKEN=local-blob-publisher-signer-token-at-least-32
WITHDRAWAL_SIGNER_URL=http://web3signer:9000
WITHDRAWAL_SIGNER_ADDRESS=0x5555555555555555555555555555555555555555
WITHDRAWAL_SIGNER_AUTH_TOKEN=local-withdrawal-signer-token-at-least-32
# Optional one-generation overlap for a controlled signer-token rotation.
WITHDRAWAL_SIGNER_PREVIOUS_AUTH_TOKEN=
CAPACITY_PROVIDER_URL=https://capacity-provider.local.invalid/v1
CAPACITY_PROVIDER_AUTH_TOKEN=local-capacity-provider-token-at-least-32
# Optional one-generation overlap for a controlled provider-token rotation.
CAPACITY_PROVIDER_PREVIOUS_AUTH_TOKEN=
CAPACITY_LEASE_TTL_MS=30000
CAPACITY_BATCH_SIZE=20

# Automated failover remains unarmed in the local example. Production uses
# two independent HTTPS witnesses and three distinct operator-owned token
# files; never put their contents in this environment file.
ACTIVE_PROMOTION_HEALTH_URLS=https://active-witness-a.local.invalid/health,https://active-witness-b.local.invalid/health
FAILOVER_PROVIDER_URL=https://failover-provider-docker:8443/v1/failovers
FAILOVER_PROVIDER_ACTIVE_HEALTH_URLS=https://active-witness-a.local.invalid/health,https://active-witness-b.local.invalid/health
FAILOVER_PROVIDER_INDEXER_FRESHNESS_URL=https://indexer.local.invalid/hosting/v1/finality-status
PROMOTION_CANDIDATE_ID=local-candidate-not-armed
PROMOTION_CONTROLLER_ARMED=false
PROMOTION_FAILURE_THRESHOLD=3
PROMOTION_POLL_SECONDS=10
PROMOTION_MAX_RTO_SECONDS=240
PROMOTION_MAX_CHECKPOINT_AGE_SECONDS=30
PROMOTION_REQUEST_TIMEOUT_SECONDS=10
FAILOVER_PROVIDER_TOKEN_FILE=../.state/local/promotion/failover-provider.token
FAILOVER_APPROVAL_TOKEN_FILE=../.state/local/promotion/failover-approval.token
PROMOTION_PRINCIPAL_TOKEN_FILE=../.state/local/promotion/promotion-principal.token
FAILOVER_PROVIDER_TLS_CERT_FILE=../.state/local/promotion/failover-provider.crt
FAILOVER_PROVIDER_TLS_KEY_FILE=../.state/local/promotion/failover-provider.key
POSTGRES_REPLICATION_PASSWORD_FILE=../.state/local/promotion/postgres-replication-password
POSTGRES_PASSWORD_FILE=../.state/local/promotion/postgres-password
DOCKER_SOCKET_GID=0

# Create these untracked operator files before enabling the hosted profile. The
# config must reference /run/zkdeal-secrets/{keys.json,
# control.token}, /var/lib/zkdeal-room-node and /opt/zkdeal/artifacts.
ROOM_NODE_CONFIG_FILE=../.state/local/room-node/room-node.json
ROOM_NODE_KEYS_FILE=../.state/local/room-node/keys.json
ROOM_NODE_CONTROL_TOKEN_FILE=../.state/local/room-node/control.token
ROOM_NODE_ARTIFACT_DIR=../.state/local/room-node/artifacts
# Persistent candidate-scoped OCI registry used when no external registry is supplied.
OCI_REGISTRY_PORT=5000
OCI_REGISTRY_VOLUME=zkdeal-oci-registry
