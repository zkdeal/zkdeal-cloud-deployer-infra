{
  "schemaVersion": 1,
  "name": "production-example",
  "environment": "production",
  "publicExposure": true,
  "chain": {
    "id": 1,
    "rpcUrls": ["https://rpc-a.invalid.example", "https://rpc-b.invalid.example"],
    "contracts": {
      "roomManager": "0x0000000000000000000000000000000000000000",
      "roomPool": "0x0000000000000000000000000000000000000000",
      "accessToken": "0x0000000000000000000000000000000000000000"
    },
    "maximumArchiveLagBlocks": 8
  },
  "services": {
    "coordinator": { "enabled": true, "replicas": 2, "port": 3000, "healthPath": "/hosting/v1/health" },
    "queue": { "enabled": false, "replicas": 1, "port": 3005, "healthPath": "/health" },
    "prover": { "enabled": true, "replicas": 1, "port": 8080, "healthPath": "/healthz" },
    "agent": { "enabled": true, "replicas": 1, "port": 9091, "healthPath": "/health" },
    "docs": { "enabled": true, "replicas": 1, "port": 8080, "healthPath": "/" }
  },
  "storage": {
    "backend": "external-transactional",
    "dataRoot": "/var/lib/zkdeal",
    "backupRoot": "/var/backups/zkdeal",
    "retentionDays": 365,
    "hotRetentionDays": 30,
    "archiveRetentionDays": 365
  },
  "availability": {
    "mode": "warm-standby",
    "fencing": "owner-service-transactional",
    "rpoMinutes": 1,
    "rtoMinutes": 4,
    "multiRegion": false,
    "warmStandbyReplicas": 1
  },
  "security": {
    "tlsMode": "external",
    "trustedProxyCidrs": ["192.0.2.0/24"],
    "corsOrigins": ["https://zkdeal.invalid.example"],
    "secretSource": "external-secret-provider",
    "existingSecret": "zkdeal-production-secrets",
    "signerRoles": {
      "liveness": {
        "enabled": true,
        "address": "https://web3signer-liveness.service.example",
        "allowedServices": ["coordinator-active"]
      },
      "operationsSettlement": {
        "enabled": true,
        "address": "https://web3signer-operations.service.example",
        "allowedServices": ["coordinator-active"]
      },
      "payout": {
        "enabled": true,
        "address": "https://web3signer-payout.service.example",
        "allowedServices": ["provider-payout"]
      },
      "finalityOracle": {
        "enabled": true,
        "address": "https://web3signer-finality.service.example",
        "allowedServices": ["finality-oracle"]
      },
      "sponsorRelayer": {
        "enabled": true,
        "address": "https://web3signer-sponsor.service.example",
        "allowedServices": ["sponsorship"]
      },
      "withdrawalRelayer": {
        "enabled": true,
        "address": "https://web3signer-withdrawal.service.example",
        "allowedServices": ["auto-claimer"]
      }
    }
  },
  "observability": {
    "enabled": true,
    "scrapeIntervalSeconds": 15,
    "alertsEnabled": true,
    "externalLabels": { "environment": "production" }
  },
  "images": {
    "manifest": "config/images.lock.json",
    "overrides": null,
    "allowTagOverrides": false
  }
}
