{
  "schemaVersion": 1,
  "name": "warm-standby",
  "environment": "staging",
  "publicExposure": false,
  "chain": {
    "id": 11155111,
    "rpcUrls": ["https://rpc-a.invalid.example", "https://rpc-b.invalid.example"],
    "contracts": {
      "roomManager": "0x0000000000000000000000000000000000000000",
      "roomPool": "0x0000000000000000000000000000000000000000",
      "accessToken": "0x0000000000000000000000000000000000000000"
    },
    "maximumArchiveLagBlocks": 8
  },
  "services": {
    "coordinator": { "enabled": true, "replicas": 2, "port": 3000, "healthPath": "/hosting/v1/health" },
    "queue": { "enabled": false, "replicas": 1, "port": 3005, "healthPath": "/health" },
    "prover": { "enabled": true, "replicas": 1, "port": 8080, "healthPath": "/healthz" },
    "agent": { "enabled": true, "replicas": 1, "port": 9091, "healthPath": "/health" },
    "docs": { "enabled": true, "replicas": 1, "port": 8080, "healthPath": "/" }
  },
  "storage": {
    "backend": "external-transactional",
    "dataRoot": ".state/warm-standby",
    "backupRoot": ".state/warm-standby/backups",
    "retentionDays": 365,
    "hotRetentionDays": 30,
    "archiveRetentionDays": 365
  },
  "availability": {
    "mode": "warm-standby",
    "fencing": "owner-service-transactional",
    "rpoMinutes": 1,
    "rtoMinutes": 4,
    "multiRegion": false,
    "warmStandbyReplicas": 1
  },
  "security": {
    "tlsMode": "external",
    "trustedProxyCidrs": ["192.0.2.0/24"],
    "corsOrigins": ["https://warm-standby.invalid.example"],
    "secretSource": "external-secret-provider",
    "existingSecret": "zkdeal-warm-standby-secrets"
  },
  "observability": {
    "enabled": true,
    "scrapeIntervalSeconds": 15,
    "alertsEnabled": true,
    "externalLabels": { "environment": "warm-standby" }
  },
  "images": {
    "manifest": "config/images.lock.json",
    "overrides": null,
    "allowTagOverrides": false
  }
}
