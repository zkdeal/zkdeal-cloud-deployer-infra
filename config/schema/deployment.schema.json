{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zkdeal.example/schemas/deployment.schema.json",
  "title": "zkdeal deployment profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "environment",
    "publicExposure",
    "chain",
    "services",
    "storage",
    "availability",
    "security",
    "observability",
    "images"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "environment": { "enum": ["local", "staging", "production"] },
    "publicExposure": { "type": "boolean" },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rpcUrls", "contracts", "maximumArchiveLagBlocks"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "rpcUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https?://" }
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roomManager", "roomPool", "accessToken"],
          "properties": {
            "roomManager": { "$ref": "#/$defs/address" },
            "roomPool": { "$ref": "#/$defs/address" },
            "accessToken": { "$ref": "#/$defs/address" }
          }
        },
        "maximumArchiveLagBlocks": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinator", "queue", "prover", "agent", "docs"],
      "properties": {
        "coordinator": { "$ref": "#/$defs/service" },
        "queue": { "$ref": "#/$defs/service" },
        "prover": { "$ref": "#/$defs/service" },
        "agent": { "$ref": "#/$defs/service" },
        "docs": { "$ref": "#/$defs/service" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "dataRoot", "backupRoot", "retentionDays"],
      "properties": {
        "backend": { "enum": ["filesystem", "external-transactional"] },
        "dataRoot": { "type": "string", "minLength": 1 },
        "backupRoot": { "type": "string", "minLength": 1 },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "hotRetentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "archiveRetentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fencing", "rpoMinutes", "rtoMinutes"],
      "properties": {
        "mode": { "enum": ["single-instance", "single-region", "warm-standby"] },
        "fencing": { "enum": ["none", "owner-service-transactional"] },
        "rpoMinutes": { "type": "integer", "minimum": 0 },
        "rtoMinutes": { "type": "integer", "minimum": 1 },
        "multiRegion": { "type": "boolean", "default": false },
        "warmStandbyReplicas": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tlsMode", "trustedProxyCidrs", "corsOrigins", "secretSource"],
      "properties": {
        "tlsMode": { "enum": ["disabled", "files", "acme", "external"] },
        "trustedProxyCidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "corsOrigins": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https?://[^/]+$" }
        },
        "secretSource": { "enum": ["dotenv-local", "kubernetes-secret", "external-secret-provider"] },
        "existingSecret": { "type": ["string", "null"] },
        "signerRoles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["liveness", "operationsSettlement", "payout", "finalityOracle", "sponsorRelayer", "withdrawalRelayer"],
          "properties": {
            "liveness": { "$ref": "#/$defs/signerRole" },
            "operationsSettlement": { "$ref": "#/$defs/signerRole" },
            "payout": { "$ref": "#/$defs/signerRole" },
            "finalityOracle": { "$ref": "#/$defs/signerRole" },
            "sponsorRelayer": { "$ref": "#/$defs/signerRole" },
            "withdrawalRelayer": { "$ref": "#/$defs/signerRole" }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "scrapeIntervalSeconds", "alertsEnabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "scrapeIntervalSeconds": { "type": "integer", "minimum": 5, "maximum": 300 },
        "alertsEnabled": { "type": "boolean" },
        "externalLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "allowTagOverrides"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "overrides": { "type": ["string", "null"] },
        "allowTagOverrides": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "signerRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "address", "allowedServices"],
      "properties": {
        "enabled": { "type": "boolean" },
        "address": { "type": ["string", "null"], "pattern": "^https?://" },
        "allowedServices": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "healthPath": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
