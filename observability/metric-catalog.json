        {"name":"zkdeal_sse_events_batched_total","type":"counter","unit":"events","labels":[],"status":"standalone-only"},
        {"name":"zkdeal_sse_events_dropped_total","type":"counter","unit":"events","labels":[],"status":"standalone-only"}
