{
  "schemaVersion": 1,
  "cardinalityPolicy": {
    "forbiddenLabels": ["tenant_id", "tenantId", "room_id", "roomId", "job_id", "jobId", "principal_id", "principalId", "transaction_hash"],
    "maximumBoundedValuesPerLabel": 64
  },
  "domains": {
    "l1-finality": {
      "dashboard": "l1-finality.json",
      "metrics": [
        {"name":"zkdeal_l1_quorum_healthy","type":"gauge","unit":"boolean","labels":[],"status":"owner-published"},
        {"name":"zkdeal_l1_reorgs_total","type":"counter","unit":"reorgs","labels":[],"status":"owner-published"},
        {"name":"zkdeal_finality_undercuts_total","type":"counter","unit":"events","labels":[],"status":"required-owner-contract"},
        {"name":"zkdeal_l1_post_finality_surprises_total","type":"counter","unit":"events","labels":[],"status":"owner-published"},
        {"name":"zkdeal_deadline_risk_jobs","type":"gauge","unit":"jobs","labels":["service_class"],"status":"owner-published"}
      ]
    },
    "indexer": {
      "dashboard": "indexer.json",
      "metrics": [
        {"name":"zkdeal_hosted_worker_up","type":"gauge","unit":"boolean","labels":["job"],"status":"owner-published"},
        {"name":"zkdeal_hosted_worker_running","type":"gauge","unit":"boolean","labels":["job"],"status":"owner-published"},
        {"name":"zkdeal_hosted_worker_completed_runs_total","type":"counter","unit":"runs","labels":["job"],"status":"owner-published"},
        {"name":"zkdeal_hosted_worker_processed_blocks_total","type":"counter","unit":"blocks","labels":["job"],"status":"owner-published"},
