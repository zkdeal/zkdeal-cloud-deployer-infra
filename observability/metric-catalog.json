      "dashboard": "blob.json",
      "metrics": [
        {"name":"zkdeal_blob_publisher_up","type":"gauge","unit":"boolean","labels":[],"status":"owner-published"},
        {"name":"zkdeal_blob_publish_processed_total","type":"counter","unit":"operations","labels":[],"status":"owner-published"},
        {"name":"zkdeal_blob_publish_errors_total","type":"counter","unit":"errors","labels":[],"status":"owner-published"},
        {"name":"zkdeal_l1_post_finality_surprise_total","type":"counter","unit":"events","labels":[],"status":"owner-published"},
        {"name":"zkdeal_blob_publisher_completed_runs_total","type":"counter","unit":"runs","labels":[],"status":"owner-published"},
