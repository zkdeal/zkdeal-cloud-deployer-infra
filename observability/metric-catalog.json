        {"name":"zkdeal_prover_requests_total","type":"counter","unit":"requests","labels":["route","outcome"],"status":"owner-published"},
        {"name":"zkdeal_prover_gpu_utilization_percent","type":"gauge","unit":"percent","labels":[],"status":"owner-published"},
        {"name":"zkdeal_prover_gpu_memory_used_mib","type":"gauge","unit":"mebibytes","labels":[],"status":"owner-published"},
        {"name":"zkdeal_prover_gpu_power_watts","type":"gauge","unit":"watts","labels":[],"status":"owner-published"}
