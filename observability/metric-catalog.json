        {"name":"zkdeal_indexer_lag_blocks","type":"gauge","unit":"blocks","labels":[],"status":"owner-published"},
        {"name":"zkdeal_indexer_retractions_total","type":"counter","unit":"events","labels":["reason"],"status":"owner-published"}
      ]
    },
    "wal-admission": {
      "dashboard": "wal-admission.json",
      "metrics": [
        {"name":"zkdeal_admission_wal_records","type":"gauge","unit":"records","labels":["status"],"status":"owner-published"},
        {"name":"zkdeal_admission_wal_recovered_total","type":"counter","unit":"records","labels":["outcome"],"status":"owner-published"}
      ]
    },
    "room": {
      "dashboard": "room.json",
      "metrics": [
        {"name":"zkdeal_room_node_up","type":"gauge","unit":"boolean","labels":[],"status":"owner-published"},
