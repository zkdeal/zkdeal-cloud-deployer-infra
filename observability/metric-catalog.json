        {"name":"zkdeal_withdrawal_worker_runs_total","type":"counter","unit":"runs","labels":[],"status":"owner-published"},
        {"name":"zkdeal_withdrawal_worker_last_success_timestamp_seconds","type":"gauge","unit":"unix-seconds","labels":[],"status":"owner-published"}
      ]
    },
    "capacity": {
      "dashboard": "capacity.json",
      "metrics": [
        {"name":"zkdeal_capacity_worker_up","type":"gauge","unit":"boolean","labels":[],"status":"owner-published"},
        {"name":"zkdeal_capacity_worker_running","type":"gauge","unit":"boolean","labels":[],"status":"owner-published"},
        {"name":"zkdeal_capacity_worker_runs_total","type":"counter","unit":"runs","labels":[],"status":"owner-published"},
        {"name":"zkdeal_capacity_operations_total","type":"counter","unit":"operations","labels":["status"],"status":"owner-published"},
